# Copiar a terraform.tfvars (ignorado por Git). Valores ficticios.
owner                    = "andres"
permissions_boundary_arn = "arn:aws:iam::000000000000:policy/agentic-boundary"

# AMI de Ubuntu 24.04 LTS amd64 en us-east-1. Se resuelve una vez y se fija (plan §1.1 #21):
#   aws ssm get-parameter --region us-east-1 \
#     --name /aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id \
#     --query Parameter.Value --output text
ami_id = "ami-00000000000000000" # TODO(verify): sustituir por la AMI resuelta

allowed_cidrs               = ["0.0.0.0/0"]
control_plane_instance_type = "t3.large"
worker_instance_type        = "t3.medium"

# Datasource CloudWatch de Grafana Cloud (opcional; si alguno queda vacío, no se crea el rol).
# Grafana Cloud muestra la cuenta y el external ID al crear la conexión AWS.
grafana_cloud_aws_account_id   = "" # TODO(verify): cuenta AWS de Grafana Cloud
grafana_cloudwatch_external_id = ""
