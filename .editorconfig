root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,bash,tftpl}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
# Dos espacios al final = salto de línea en Markdown.
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf
