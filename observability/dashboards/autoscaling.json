{
  "uid": "agentic-autoscaling",
  "title": "Agentic · Autoscaling",
  "tags": [
    "agentic-platform",
    "autoscaling"
  ],
  "description": "Cadena KEDA/HPA -> Pending -> Cluster Autoscaler -> ASG -> NLB (plan §2.F).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Pods (KEDA y HPA)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Réplicas HPA actuales vs deseadas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{cluster=\"agentic-platform\",namespace=\"apps\"}",
          "legendFormat": "{{horizontalpodautoscaler}} actuales",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{cluster=\"agentic-platform\",namespace=\"apps\"}",
          "legendFormat": "{{horizontalpodautoscaler}} deseadas",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Valor de los escaladores KEDA",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keda_scaler_metrics_value{cluster=\"agentic-platform\"}",
          "legendFormat": "{{scaledObject}} · {{scaler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pods Pending (apps)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{cluster=\"agentic-platform\",namespace=\"apps\",phase=\"Pending\"})",
          "legendFormat": "Pending",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores de los escaladores KEDA",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scaledObject) (rate(keda_scaler_detail_errors_total{cluster=\"agentic-platform\"}[$__rate_interval]))",
          "legendFormat": "{{scaledObject}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Nodos (Cluster Autoscaler y ASG)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Nodos según el CA",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cluster_autoscaler_nodes_count{cluster=\"agentic-platform\"}",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pods no programables vistos por el CA",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cluster_autoscaler_unschedulable_pods_count{cluster=\"agentic-platform\"}",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Scale-up / scale-down del CA",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(cluster_autoscaler_scaled_up_nodes_total{cluster=\"agentic-platform\"}[5m])",
          "legendFormat": "scale-up",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "increase(cluster_autoscaler_scaled_down_nodes_total{cluster=\"agentic-platform\"}[5m])",
          "legendFormat": "scale-down",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ASG (CloudWatch)",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "agentic-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupDesiredCapacity",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        },
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupInServiceInstances",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        },
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupPendingInstances",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        }
      ]
    }
  ]
}
