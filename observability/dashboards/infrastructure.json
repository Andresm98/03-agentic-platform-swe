{
  "uid": "agentic-infrastructure",
  "title": "Agentic · Infraestructura",
  "tags": [
    "agentic-platform",
    "infra"
  ],
  "description": "Nodos EC2 (node-exporter) y ASG (CloudWatch, datasource agentic-cloudwatch).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "ASG de workers (CloudWatch: métricas de grupo sin costo)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Capacidad del ASG",
      "description": "Techo: 2 workers (3 EC2 con el CP). DesiredCapacity lo cambia el Cluster Autoscaler.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "agentic-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupDesiredCapacity",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        },
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupInServiceInstances",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        },
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupPendingInstances",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        },
        {
          "namespace": "AWS/AutoScaling",
          "metricName": "GroupTerminatingInstances",
          "region": "us-east-1",
          "statistic": "Maximum",
          "dimensions": {
            "AutoScalingGroupName": [
              "agentic-platform-worker"
            ]
          },
          "period": "60",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": "",
          "refId": "D",
          "datasource": {
            "type": "cloudwatch",
            "uid": "agentic-cloudwatch"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Nodos (node-exporter)",
      "id": 3,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU por nodo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=\"agentic-platform\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memoria usada por nodo",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{cluster=\"agentic-platform\"} / node_memory_MemTotal_bytes{cluster=\"agentic-platform\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disco raíz usado (gp3 20 GB)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{cluster=\"agentic-platform\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=\"agentic-platform\",mountpoint=\"/\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Red rx/tx",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{cluster=\"agentic-platform\",device!~\"lo|veth.*|cni.*|flannel.*\"}[$__rate_interval]))",
          "legendFormat": "rx {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "-sum by (instance) (rate(node_network_transmit_bytes_total{cluster=\"agentic-platform\",device!~\"lo|veth.*|cni.*|flannel.*\"}[$__rate_interval]))",
          "legendFormat": "tx {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load 1m por vCPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{cluster=\"agentic-platform\"} / on (instance) count by (instance) (node_cpu_seconds_total{cluster=\"agentic-platform\",mode=\"idle\"})",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU steal",
      "description": "Con cpu_credits=unlimited no hay throttling por créditos; un steal alto indica contención del host.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{cluster=\"agentic-platform\",mode=\"steal\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ]
}
