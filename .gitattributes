# Normalización por defecto: texto con LF en el repositorio.
* text=auto eol=lf

# Scripts que se ejecutan en Linux (EC2, contenedores, CI): LF obligatorio.
*.sh       text eol=lf
*.bash     text eol=lf
*.tftpl    text eol=lf
Makefile   text eol=lf
*.mk       text eol=lf
Dockerfile text eol=lf
*.py       text eol=lf
*.tf       text eol=lf
*.hcl      text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.toml     text eol=lf

# Scripts nativos de Windows.
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binarios.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zst  binary
*.tgz  binary
*.gz   binary
*.zip  binary
